POSTGRES_DB=tenderhack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
API_DB_PASSWORD=api_dev_only
KNOWLEDGE_DB_PASSWORD=knowledge_dev_only
# Keep these URLs in sync when changing POSTGRES_DB or the role passwords above.
API_DATABASE_URL=Host=postgres;Port=5432;Database=tenderhack;Username=api_rw;Password=api_dev_only
KNOWLEDGE_DATABASE_URL=postgresql+asyncpg://knowledge_rw:knowledge_dev_only@postgres:5432/tenderhack
KNOWLEDGE_BASE_URL=http://knowledge:8000
# Outer HttpClient safety net; must stay >= the largest Knowledge__Timeouts__* value (architecture.md §10).
KNOWLEDGE_TIMEOUT=00:02:00
# Per-stage timeouts (api). Draft/Verify run local generation and need a larger budget than
# understand/retrieve/answerability, which keep their appsettings.json defaults unless overridden.
KNOWLEDGE_DRAFT_TIMEOUT=00:01:30
KNOWLEDGE_VERIFY_TIMEOUT=00:00:30
KNOWLEDGE_CHECK_DB=true
ASPNETCORE_ENVIRONMENT=Development
# Local model stack V2 (OpenAI-compatible llama.cpp endpoints; internal only).
KNOWLEDGE_EMBEDDING_MODEL=ai-sage/Giga-Embeddings-instruct-3B-0826
KNOWLEDGE_EMBEDDING_RUNTIME=llama.cpp
KNOWLEDGE_EMBEDDING_BASE_URL=http://embedding-inference:8080
KNOWLEDGE_EMBEDDING_DIMENSION=2048
KNOWLEDGE_EMBEDDING_QUERY_INSTRUCTION_VERSION=giga_portal_support_v1
KNOWLEDGE_RERANKER_MODEL=Querit/Querit-4B
KNOWLEDGE_RERANKER_RUNTIME=TBD_UNVERIFIED
KNOWLEDGE_RERANKER_BASE_URL=
KNOWLEDGE_RERANKER_ENABLED=false
KNOWLEDGE_GENERATOR_MODEL=empero-ai/Qwen3.8-4B-Distill
KNOWLEDGE_GENERATOR_RUNTIME=llama.cpp
KNOWLEDGE_GENERATOR_BASE_URL=http://generator-inference:8080
KNOWLEDGE_INFERENCE_BEARER_TOKEN=
KNOWLEDGE_GENERATOR_RUNTIME_FILE=Qwen3.8-4B-Q6_K.gguf
