<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Lets `dotnet test`/`dotnet run` work on machines that only have a newer local SDK/runtime
         installed (e.g. 10.x) without a matching 9.0 one. Docker images pin the exact 9.0 runtime
         (section 4.6), so this only matters for local development. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
</Project>
