# Cloud.ru Docker RUN inference container. No secrets belong in this file.

GIGA_MODEL_PATH=/models/giga-embeddings-0826-3b-q8_0.gguf
QWEN_MODEL_PATH=/models/Qwen3.8-4B-Q6_K.gguf

GIGA_HOST=127.0.0.1
GIGA_PORT=8081
QWEN_HOST=127.0.0.1
QWEN_PORT=8082
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Required providers for the default REDUCED profile.
GIGA_EMBEDDING_DIMENSION=2048
EMBEDDING_BATCH=8
GENERATOR_CONTEXT=8192
GENERATOR_PARALLEL=4
LLAMA_GPU_LAYERS=99

# Extra llama-server flags are intentionally opt-in. Validate them with the
# exact pinned llama-server --help before enabling on the target image.
GIGA_EXTRA_ARGS=
QWEN_EXTRA_ARGS=

# Querit has no certified GGUF/provider in this package.
RERANKER_ENABLED=false
RERANKER_URL=

# If set, all /v1/* routes require Authorization: Bearer <token>.
INFERENCE_API_TOKEN=
UPSTREAM_TIMEOUT_SECONDS=30
READINESS_CACHE_SECONDS=2
STARTUP_TIMEOUT_SECONDS=300
LOG_CONTENT=false
